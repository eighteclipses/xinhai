{
  "name": "xinhai-source",
  "version": "0.2.35-source.0",
  "description": "心海共学个人版源码快照 · 非商业用途",
  "main": "./out/main/index.js",
  "author": "eighteclipses",
  "overrides": {
    "config-file-ts": "0.2.8-rc1"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "build:personal": "electron-vite build",
    "build:public": "electron-vite build",
    "build:mobile": "vite build --config vite.mobile.config.ts",
    "preview": "electron-vite preview",
    "postinstall": "electron-builder install-app-deps",
    "dist": "npm run build && electron-builder --win --ia32 --config electron-builder.yml",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test.cjs",
    "check:source": "node scripts/check-source.cjs",
    "test:native": "node scripts/check-focus-rewards.cjs",
    "test:music": "node scripts/check-music-management-store.cjs && node scripts/check-music-management.cjs"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^3.0.0",
    "better-sqlite3": "^11.10.0",
    "framer-motion": "^11.11.9",
    "howler": "^2.2.4",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "yauzl": "3.4.0",
    "yazl": "3.3.1",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/howler": "^2.2.13",
    "@types/node": "^22.9.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/yauzl": "3.4.0",
    "@types/yazl": "3.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "electron": "^33.0.2",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "esbuild": "0.21.5"
  },
  "license": "PolyForm-Noncommercial-1.0.0",
  "private": true,
  "engines": {
    "node": ">=20"
  }
